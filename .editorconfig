
root = true

[*]
indent_style = space 
indent_size = 2
tab_width = 2
continuation_indent = 2
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.json*]
insert_final_newline = true

[*.lua]
indent_style = space 
indent_size = 2
tab_width = 2
continuation_indent = 2
insert_final_newline = true
max_line_length = 80
call_arg_parentheses = remove_table_only
